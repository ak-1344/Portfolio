# Supabase Configuration
# Get these values from your Supabase project settings:
# https://app.supabase.com/project/_/settings/api

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co

# Supabase Anonymous (Public) Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Storage Bucket URL
NEXT_PUBLIC_SUPABASE_STORAGE_URL=your-storage-url.supabase.co

# Site URL
NEXT_PUBLIC_SITE_URL=https://adityak.dev

# Note: These are public keys safe for frontend use
# They are prefixed with NEXT_PUBLIC_ to be accessible in the browser
